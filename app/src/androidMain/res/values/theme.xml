<resources>
    <color name="rpd_canvas">#F5F6F8</color>
    <color name="rpd_surface">#FFFFFF</color>
    <color name="rpd_input">#F2F2F5</color>
    <color name="rpd_border">#DADBE2</color>
    <color name="rpd_ink">#23232A</color>
    <color name="rpd_secondary">#5E606C</color>
    <color name="rpd_purple">#7955BC</color>
    <color name="rpd_selection">#EFEAF8</color>
    <style name="RProbeApp" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/rpd_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/rpd_purple</item>
    </style>
    <style name="RProbeDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/rpd_purple</item>
        <item name="android:textColorPrimary">@color/rpd_ink</item>
        <item name="android:textColorSecondary">@color/rpd_secondary</item>
        <item name="android:colorControlHighlight">@color/rpd_selection</item>
        <item name="android:colorBackground">@color/rpd_surface</item>
    </style>
    <style name="RProbeInput" parent="@android:style/Widget.Material.Light.EditText">
        <item name="android:background">@drawable/rpd_input</item>
        <item name="android:textColor">@color/rpd_ink</item>
        <item name="android:textColorHighlight">@color/rpd_selection</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="@color/rpd_surface" />
            <stroke android:width="2dp" android:color="@color/rpd_purple" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="@color/rpd_input" />
            <stroke android:width="1dp" android:color="@color/rpd_border" />
        </shape>
    </item>
</selector>
